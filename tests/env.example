WILDINTEL_BASE_URL=https://tu-servidor.com
WILDINTEL_USER_NAME=tu-usuario
WILDINTEL_USER_PASSWORD=tu-contraseña
WILDINTEL_ACCESS_TOKEN=tu-token
WILDINTEL_SMOKE_ENABLED=1
WILDINTEL_LOCATION_PK=42
WILDINTEL_DEPLOYMENT_PK=7
WILDINTEL_COLLECTION_PK=23
WILDINTEL_PROJECT_PK=10
WILDINTEL_CLASSIFICATION_PROJECT_PK=15

# Tests that WRITE to the server (package upload, location/deployment/classification import).
# Opt-in; they create rows named e2e-<random> and never delete them.
WILDINTEL_ALLOW_WRITE=1
WILDINTEL_RPROJECT_PK=1
# Creating a research project with a member (v1): a user other than the one that logs in
WILDINTEL_MEMBER_USER_PK=2
# Creating a classification project (v1): a classificator the account may use
WILDINTEL_CLASSIFICATOR_PK=1
# Trapper v2: slug of a Citizen Science classification project (tests/e2e/test_project_deployments_e2e.py)
WILDINTEL_PROJECT_SLUG=your-project-slug
